# Minecraft
MC_HOST=127.0.0.1
MC_PORT=25565
BOT_NAME=MinecraftCompanion
# MC_VERSION=1.21.4
# MC_AUTH=microsoft
# MASTER_NAME=YourMinecraftName
AUTO_CLAIM_MASTER=0

# Fast decision backends. Configure at least one.
# Experiential is first by default when both are configured.
EXPERIENTIAL_API_KEY=
# EXPLABS_API_KEY=
TYPESAFE_API_KEY=
DECISION_PROVIDER_ORDER=experiential,typesafe
EXPERIENTIAL_FALLBACK_COOLDOWN_MS=300000
JEV_INTERVAL_MS=350
ACTION_TIMEOUT_MS=7000

# High-level director and dialogue (optional but recommended)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DIRECTOR_INTERVAL_MS=30000

# Irodori voice (optional; chat replies still work when disabled)
IRODORI_ENABLED=0
IRODORI_BASE_URL=http://127.0.0.1:8088
# IRODORI_VOICE=
# IRODORI_CAPTION=
IRODORI_PREFETCH=2
CHAT_REPLIES=1
